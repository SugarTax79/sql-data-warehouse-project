/*
Create Database and Schemas
Script purpose:
  This script creates a new database named 'DataWarehouse' after checking if it already exists. 

Warning: 
  If it exists, it will drop the existing db and all data in it will be permanently deleted.
*/



USE master;
GO

--Drop and recreate the 'DataWarehouse' database
IF EXISTS (SELECT 1 FROM sys.databses WHERE name = 'DataWarehouse')
BEGIN
  ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
  DROP DATABASE DAataWarehouse;
END;
GO

-- Create the 'DataWharehouse' DB
CREATE DATABASE DataWarehouse;
GO

USE DataWarehouse;
GO

--Create Schemas
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
